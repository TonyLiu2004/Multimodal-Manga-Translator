# NOT TESTED

FROM nvidia/cuda:12.1.0-base-ubuntu22.04

# 2. Prevent prompts and set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 3. Install Python and system dependencies for OpenCV
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 4. Install NVIDIA-specific PyTorch (CUDA 12.1 version)
# We don't need a special index-url for standard CUDA torch on PyPI, 
# but we explicitly install it first to ensure compatibility.
RUN pip3 install --no-cache-dir torch torchvision torchaudio

# 5. Install the rest of the requirements
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# 6. Copy project files
COPY . .

# 7. Expose and Start
EXPOSE 8000
CMD ["python3", "main.py"]